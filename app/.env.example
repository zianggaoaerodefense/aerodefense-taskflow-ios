# Supabase project credentials
# Copy this file to .env and fill in the values from your Supabase project dashboard
# (Settings → API).
#
# EXPO_PUBLIC_ prefix makes these available in the client bundle.
# These are NOT secrets — the anon key is safe for client-side use and is
# restricted by Row-Level Security. NEVER put the service role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
