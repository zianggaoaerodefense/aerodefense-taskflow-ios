# =============================================================================
# Daily Workflow Management App — .gitignore
# =============================================================================

# Xcode / iOS legacy reference
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcworkspace/xcshareddata/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xccheckout
*.xcscmblueprint
*.xcscheme

# Build artifacts
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# CocoaPods
Pods/
*.xcworkspace

# Signing — NEVER commit these
*.p12
*.mobileprovision
*.certSigningRequest
AuthKey_*.p8

# =============================================================================
# Environment / Secrets — NEVER commit these
# =============================================================================
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
*.env.local
*.env.development
*.env.staging
*.env.production
# Keep .env.example (safe placeholder values only)
!.env.example
!**/.env.example

# =============================================================================
# Node / JavaScript
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# =============================================================================
# Expo
# =============================================================================
.expo/
dist/
web-build/
expo-env.d.ts

# =============================================================================
# TypeScript
# =============================================================================
*.tsbuildinfo

# =============================================================================
# OS files
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# =============================================================================
# Fastlane (CI/CD)
# =============================================================================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/credentials.json

# =============================================================================
# Exported app data — treat as potentially sensitive
# =============================================================================
taskflow-export*.json
taskflow-export*.md

# =============================================================================
# Coverage / test output
# =============================================================================
coverage/
*.lcov
.nyc_output/

# =============================================================================
# Editor / IDE
# =============================================================================
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
