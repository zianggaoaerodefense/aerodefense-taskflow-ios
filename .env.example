# =============================================================================
# Daily Workflow Management App — Environment Variables Reference
# =============================================================================
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# This file (.env.example) contains only safe placeholder values.
#
# See docs/ENVIRONMENT_VARIABLES.md for a full description of every variable.
# =============================================================================

# -----------------------------------------------------------------------------
# MOBILE APP (Client-side — Expo)
# These values are bundled into the app at build time.
# EXPO_PUBLIC_* variables are visible in the client bundle — do NOT use secrets.
# The anon key is safe for client-side use; Supabase RLS restricts what it can do.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# SERVER / BACKEND (Never expose these to the mobile app or any client)
# Used only in trusted server environments: Edge Functions, CI scripts,
# backend APIs, or agent server-side logic.
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-NEVER-use-in-client

# -----------------------------------------------------------------------------
# AI / AGENT (Server-side only — never in the mobile app)
# Choose the provider(s) your agent runtime uses.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS (Server-side only)
# Users configure their own credentials for each integration they enable.
# -----------------------------------------------------------------------------
# SLACK_BOT_TOKEN=your-slack-bot-token
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_BASE_URL=https://your-org.atlassian.net
# GITHUB_TOKEN=your-github-personal-access-token
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
